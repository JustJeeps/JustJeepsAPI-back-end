generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  entity_id             Int             @id
  id                    Int             @unique @default(autoincrement())
  created_at            String
  updated_at            String          @default(dbgenerated("now()::text"))
  customer_email        String
  coupon_code           String?
  customer_firstname    String?
  customer_lastname     String?
  grand_total           Float
  increment_id          String
  order_currency_code   String
  total_qty_ordered     Int
  status                String?
  base_total_due        Float?
  shipping_amount       Float?
  shipping_cost_jj      String?         @db.Text
  shipping_description  String?
  custom_po_number      String?
  weltpixel_fraud_score Float?
  email_first_seen      String?
  city                  String?
  region                String?
  method_title          String?
  shipping_city         String?
  shipping_country_id   String?
  shipping_firstname    String?
  shipping_lastname     String?
  shipping_postcode     String?
  shipping_region       String?
  shipping_street1      String?
  shipping_street2      String?
  shipping_street3      String?
  shipping_telephone    String?
  shipping_company      String?
  billing_city          String?
  billing_country_id    String?
  billing_postcode      String?  
  billing_region        String?
  billing_street       String?
  sales_rep             String?
  subtotal              Float?
  freight_shipping      Float?
  order_bis             Float?
  tax_amount            Float?
  custom_order_note     String?
  custom_ship_status    String?
  items                 OrderProduct[]
  purchaseOrder         PurchaseOrder[]

  @@index([created_at])
}

model OrderProduct {
  id                     Int            @id @default(autoincrement())
  name                   String
  sku                    String
  order_id               Int
  base_price             Float
  base_price_incl_tax    Float?
  discount_amount        Float
  discount_invoiced      Float
  discount_percent       Float
  original_price         Float
  price                  Float
  price_incl_tax         Float?
  product_id             Int?
  qty_ordered            Int
  selected_supplier      String?
  selected_supplier_cost String?
  vendor_product_id      Int?
  order                  Order          @relation(fields: [order_id], references: [entity_id], onDelete: Cascade)
  product                Product        @relation(fields: [sku], references: [sku], onDelete: Cascade)
  vendorProduct          VendorProduct? @relation(fields: [vendor_product_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([sku])
}

model Product {
  sku                String              @id @unique
  status             Int?
  name               String
  price              Float
  searchableSku      String
  searchable_sku     String?
  jj_prefix          String?
  meyer_code         String?
  keystone_code      String?
  keystone_code_site String?
  keystone_brand_code String?
  keystone_qb_code     String?
  omix_code          String?
  replace_oe         String?
  vendors            String?
  brand_name         String?
  image              String?
  weight             Float?
  url_path           String?
  quadratec_code     String?
  quadratec_pn       String?
  rough_country_code String?
  gentecdirect_code  String?
  MAP                Float?
  partStatus_meyer   String?
  height             Float?
  length             Float?
  width              Float?
  meyer_height       Float?
  meyer_length       Float?
  meyer_weight       Float?
  meyer_width        Float?
  tdot_code          String?
  shippingFreight    String?
  part               String?
  thumbnail          String?
  ctp_code           String?
  partsEngine_code   String?
  tdot_url           String?
  keystone_ftp_brand String?
  t14_code           String?
  premier_code       String?
  black_friday_sale  String?
  t14_id             String?
  contentHash        String?
  competitorProducts CompetitorProduct[]
  orderProducts      OrderProduct[]
  vendorProducts     VendorProduct[]

  @@index([status])
}

model SkuStatusChangeHistory {
  id                Int      @id @default(autoincrement())
  recordKey         String   @unique
  recordedAt        DateTime @default(now())
  reportDate        String
  timeZone          String
  changedBy         String
  changedByName     String
  changedByEmail    String?
  source            String
  requestedSku      String
  sku               String
  title             String?
  status            Int
  action            String
  applyToChildren   Boolean  @default(false)
  updatedStoreViews Json?
  failedStoreViews  Json?

  @@index([reportDate])
  @@index([recordedAt])
  @@index([changedBy])
  @@index([sku])
}

model OrderCancellationWorkflowHistory {
  id                             Int       @id @default(autoincrement())
  recordKey                      String    @unique
  recordedAt                     DateTime  @default(now())
  reportDate                     String
  timeZone                       String
  cancelledAt                    DateTime?
  cancelledBy                    String
  dryRun                         Boolean   @default(false)
  outcome                        String
  orderId                        Int?
  incrementId                    String?
  requestedOrderIdentifier       String?
  orderCancelledInMagento        Boolean   @default(false)
  invoiceVoidDeleteCompleted     Boolean   @default(false)
  cancellationTicketSent         Boolean   @default(false)
  cancellationAttributesUpdated  Boolean   @default(false)
  localStatusUpdated             Boolean   @default(false)
  failedActions                  Json?
  completedActions               Json?
  manualActionsStillRequired     Json?
  orderSnapshot                  Json?

  @@index([reportDate])
  @@index([recordedAt])
  @@index([cancelledBy])
  @@index([orderId])
  @@index([incrementId])
}

model VendorProduct {
  id                      Int            @id @default(autoincrement())
  product_sku             String
  vendor_id               Int
  vendor_sku              String
  vendor_cost             Float
  vendor_inventory        Float?
  partStatus_meyer        String?
  vendor_inventory_string String?
  quadratec_sku           String?
  manufacturer_sku        String?
  vendor_retail_price_usd Float?
  vendor_cost_usd         Float?
  quadratec_shipping_surcharge_usd Float?
  // Pipeline de ingestao (jul/2026): hash do payload do vendor p/ skip de
  // no-ops, hash do ultimo push ao Magento p/ so enviar o que mudou, e
  // updatedAt informativo (seeds raw-SQL nao o atualizam).
  contentHash             String?
  lastPushedHash          String?
  lastPushedAt            DateTime?
  updatedAt               DateTime       @default(now()) @updatedAt
  orderProducts           OrderProduct[]
  product                 Product        @relation(fields: [product_sku], references: [sku], onDelete: Cascade)
  vendor                  Vendor         @relation(fields: [vendor_id], references: [id])

  @@unique([vendor_id, vendor_sku])
  @@index([product_sku])
}

model Vendor {
  id             Int             @id @default(autoincrement())
  name           String
  website        String
  address        String?
  phone_number   String?
  main_contact   String
  username       String
  password       String
  purchaseOrders PurchaseOrder[]
  vendorProducts VendorProduct[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  firstname          String
  lastname           String
  username           String
  email              String
  password           String
  purchaseOrders     PurchaseOrder[]
  requestsCreated    Request[]           @relation("RequestRequester")
  requestsAssigned   Request[]           @relation("RequestAssignee")
  requestComments    RequestComment[]    @relation("RequestCommentAuthor")
  requestAttachments RequestAttachment[] @relation("RequestAttachmentUploader")
  requestActivities  RequestActivity[]   @relation("RequestActivityActor")
  requestAssignments RequestAssignee[]   @relation("RequestAssigneeUser")
  trelloBoard        TrelloUserBoard?    @relation("UserTrelloBoard")
}

// ---------------------------------------------------------------------------
// Requests: sistema de chamados internos do Pricing Tool (substitui as listas
// de pedidos por e-mail). Status/priority/project/type sao Strings validadas
// contra as constantes de config/requests.js (padrao do repo: sem enums).
// ---------------------------------------------------------------------------

model Request {
  id           Int                 @id @default(autoincrement())
  title        String
  description  String              @db.Text
  project      String
  type         String
  priority     String              @default("Normal")
  status       String              @default("New Request")
  links        Json?
  // Integracao one-way com Trello (config via painel /settings)
  trelloCardId  String?
  trelloCardUrl String?
  // Arquivado: some dos filtros padrao da tela, mas fica salvo. Autor e triage
  // arquivam em qualquer status (regra em lib/requests/archive.js).
  archivedAt   DateTime?
  // Deletado (soft delete, 2026-08-07): some da tela para todo mundo, inclusive
  // da view Archived, mas NADA e apagado — comentarios, anexos no bucket e card
  // do Trello ficam intactos. So triage restaura.
  deletedAt    DateTime?
  deletedById  Int?
  requester_id Int
  assignee_id  Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  requester    User                @relation("RequestRequester", fields: [requester_id], references: [id])
  // assignee = responsavel PRIMARIO (primeiro da lista): dirige board do
  // Trello, auto-status e KPI de unassigned. A lista completa fica em assignees.
  assignee     User?               @relation("RequestAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  assignees    RequestAssignee[]
  comments     RequestComment[]
  attachments  RequestAttachment[]
  activities   RequestActivity[]

  @@index([status])
  @@index([assignee_id])
  @@index([requester_id])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model RequestComment {
  id         Int      @id @default(autoincrement())
  request_id Int
  author_id  Int
  body       String   @db.Text
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())
  request    Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  author     User     @relation("RequestCommentAuthor", fields: [author_id], references: [id])

  @@index([request_id])
}

model RequestAttachment {
  id           Int      @id @default(autoincrement())
  request_id   Int
  uploader_id  Int
  originalName String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  request      Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  uploader     User     @relation("RequestAttachmentUploader", fields: [uploader_id], references: [id])

  @@index([request_id])
}

model RequestActivity {
  id         Int      @id @default(autoincrement())
  request_id Int
  actor_id   Int
  action     String // created|status_change|assignee_change|priority_change|field_update|comment_added|attachment_added|attachment_removed|reopened|archived|unarchived|trello_card_created|trello_card_skipped|trello_card_failed
  field      String?
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  request    Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  actor      User     @relation("RequestActivityActor", fields: [actor_id], references: [id])

  @@index([request_id])
  @@index([createdAt])
}

// Multi-assignee (decisao de 2026-08-03): um chamado pode ter varios
// responsaveis. Request.assignee_id continua como o primario (= primeiro da
// lista enviada no PATCH assigneeIds).
model RequestAssignee {
  id         Int      @id @default(autoincrement())
  request_id Int
  user_id    Int
  createdAt  DateTime @default(now())
  request    Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  user       User     @relation("RequestAssigneeUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([request_id, user_id])
  @@index([user_id])
}

// ---------------------------------------------------------------------------
// Integracao Trello configurada pelo painel /settings (usuarios de triage).
// Credencial global unica (linha singleton id=1) + mapeamento usuario ->
// board/lista de destino (card do request vai para o board do assignee).
// apiToken em plaintext por decisao: DB interno, token revogavel no Trello,
// e criptografia exigiria chave em env (que esta feature elimina). O token
// NUNCA sai da API sem mascara (ver lib/trello/settings.js).
// ---------------------------------------------------------------------------

model TrelloSettings {
  id          Int      @id @default(1)
  apiKey      String?
  apiToken    String?
  updatedById Int?
  updatedAt   DateTime @default(now()) @updatedAt
}

model TrelloUserBoard {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  boardId   String
  boardName String
  listId    String
  listName  String
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation("UserTrelloBoard", fields: [userId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id                     Int                     @id @default(autoincrement())
  created_at             DateTime                @default(now())
  user_id                Int
  order_id               Int
  vendor_id              Int
  order                  Order                   @relation(fields: [order_id], references: [entity_id])
  user                   User                    @relation(fields: [user_id], references: [id])
  vendor                 Vendor                  @relation(fields: [vendor_id], references: [id])
  purchaseOrderLineItems PurchaseOrderLineItem[]
}

model PurchaseOrderLineItem {
  id                 Int           @id @default(autoincrement())
  purchase_order_id  Int
  vendor_product_id  Int?
  quantity_purchased Int
  vendor_cost        Float?
  product_sku        String?
  vendor_sku         String?
  purchaseOrder      PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
}

model Competitor {
  id                 Int                 @id @default(autoincrement())
  name               String
  website            String
  competitorProducts CompetitorProduct[]
}

model CompetitorProduct {
  id               Int        @id @default(autoincrement())
  product_sku      String
  competitor_id    Int
  product_url      String?
  competitor_price Float
  competitor_sku   String?
  competitor       Competitor @relation(fields: [competitor_id], references: [id])
  product          Product    @relation(fields: [product_sku], references: [sku], onDelete: Cascade)
}

model QuickBooksImport {
  id                           Int       @id @default(autoincrement())
  importedAt                   DateTime  @default(now())
  sourceExportedAt             DateTime?
  status                       String    @default("pending")
  customers                    Int       @default(0)
  transactionsGroupedCustomers Int       @default(0)
  errors                       Json?

  @@index([status, id])
}

model QuickBooksCustomer {
  id                   Int      @id @default(autoincrement())
  importId             Int
  customerCode         String

  // Campos crus do CSV (reproduzem o spread do details verbatim)
  searchName           String   @default("")
  firstName            String   @default("")
  lastName             String   @default("")
  companyName          String   @default("")
  invoiceTo            String   @default("")
  invoiceToAddress     String   @default("")
  email                String   @default("")
  phone                String   @default("")
  phoneDigits          String   @default("")
  balance              Float    @default(0)
  street1              String   @default("")
  street2              String   @default("")
  city                 String   @default("")
  province             String   @default("")
  postalCode           String   @default("")
  country              String   @default("")

  // Derivados de exibicao
  displayName          String   @default("")
  address              String   @default("")

  // Chaves de busca/ordenacao pre-normalizadas (calculadas no import)
  searchNameNorm       String   @default("")
  displayNameNorm      String   @default("")
  emailNorm            String   @default("")
  addressNorm          String   @default("")
  codeNorm             String   @default("")
  codeSort             String   @default("")
  phoneSearch          String   @default("")
  phoneSortDigits      String   @default("")

  // Stats denormalizadas (calculateStats no import)
  hasPurchasedBefore   Boolean  @default(false)
  invoiceCount         Int      @default(0)
  paymentCount         Int      @default(0)
  totalAmountPurchased Float    @default(0)
  totalCreditAmount    Float    @default(0)
  lifetimeValue        Float    @default(0)
  firstPurchaseDate    String?
  lastPurchaseDate     String?
  lastPurchaseSortAt   DateTime
  transactionCount     Int      @default(0)
  recentTransactions   Json?

  @@unique([importId, customerCode])
  @@index([importId, displayNameNorm])
  @@index([importId, emailNorm])
  @@index([importId, addressNorm])
  @@index([importId, lifetimeValue])
  @@index([importId, invoiceCount])
  @@index([importId, paymentCount])
  @@index([importId, lastPurchaseSortAt])
  @@index([importId, phoneSortDigits])
  @@index([importId, codeSort])
}

// Estado de sincronizacao (watermark do delta de pedidos + lock cross-process
// por lease — advisory lock nao sobrevive ao pool de conexoes do Prisma)
model SyncState {
  key         String    @id
  value       String?
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model IngestRun {
  id              Int       @id @default(autoincrement())
  feed            String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running") // running|success|failed|skipped-unchanged|skipped-locked
  sourceKind      String?   // magento|csv|xlsx|api|ftp
  sourceRef       String?
  sourceHash      String?
  sourceMtime     DateTime?
  sourceRowCount  Int?
  rowsInserted    Int       @default(0)
  rowsUpdated     Int       @default(0)
  rowsMarkedStale Int       @default(0)
  rowsDeleted     Int       @default(0)
  rowsSkipped     Int       @default(0)
  watermarkFrom   String?
  watermarkTo     String?
  error           String?   @db.Text
  artifactBatchId String?   // lote de FeedArtifact consumido (proveniencia arquivo->rodada)

  @@index([feed, startedAt])
  @@index([feed, status])
}

// Catalogo dos feeds de vendor no DO Spaces (landing zone imutavel). Cada
// Catalog of the vendor feed files stored in DO Spaces (immutable landing
// zone). Each upload becomes a new object in the bucket plus a row here. Files
// that arrive together share a batchId, and a batch only becomes "current"
// when ALL the files the feed expects are available, which is the read-time
// atomicity guarantee in lib/feeds/catalog.js. Rows are never deleted:
// superseded is cheap history.
//
// objectKey is indexed but NOT unique: an object is addressed by its content,
// so the same object can be catalogued again when a later batch reuses a file
// that did not change. Making it unique broke exactly that path.
model FeedArtifact {
  id          Int      @id @default(autoincrement())
  feed        String
  fileName    String // nome canonico que os seeds esperam, ex. "Inventory.csv"
  batchId     String // uuid agrupando arquivos do mesmo fetch/upload
  objectKey   String
  sha256      String
  sizeBytes   BigInt
  contentType String?
  source      String // ftp | manual | api | local-refresh
  uploadedBy  String? // username (cron/CLI rodam fora do auth — sem FK)
  uploadedAt  DateTime @default(now())
  // Quando o arquivo foi gerado NA ORIGEM (mtime no disco de quem exportou),
  // nao quando chegou aqui. A idade lida do mtime local mente assim que o feed
  // passa a ser servido do bucket: o arquivo vira symlink pro cache e o mtime
  // vira a hora do download.
  sourceModifiedAt DateTime?
  status      String   @default("available") // available | superseded | quarantined
  note        String?  @db.Text

  @@index([feed, fileName, status, uploadedAt])
  @@index([batchId])
  @@index([objectKey])
}

# =============================================================================
# JustJeeps API - Production Environment Variables (Kamal Deploy)
# =============================================================================
# Copie para .env.production e configure os valores reais
# NUNCA commite este arquivo com valores reais!
# =============================================================================

# -----------------------------------------------------------------------------
# Digital Ocean Managed PostgreSQL
# -----------------------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Obtenha essa string no painel da Digital Ocean > Databases > Connection Details
DATABASE_URL=postgresql://doadmin:SENHA_DO_BANCO@db-postgresql-xxx-do-user-xxx-0.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# -----------------------------------------------------------------------------
# Kamal Registry (Docker Hub ou GitHub Container Registry)
# -----------------------------------------------------------------------------
# Para Docker Hub:
KAMAL_REGISTRY_USERNAME=seu_usuario_dockerhub
KAMAL_REGISTRY_PASSWORD=seu_access_token_dockerhub

# Para GitHub Container Registry (ghcr.io):
# KAMAL_REGISTRY_USERNAME=seu_usuario_github
# KAMAL_REGISTRY_PASSWORD=ghp_seu_personal_access_token

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_de_64_caracteres_ou_mais_aqui

# Currency conversion
# Used by seeding/services that convert vendor USD costs to CAD
USD_TO_CAD_RATE=1.55

# -----------------------------------------------------------------------------
# Cron Scheduler
# -----------------------------------------------------------------------------
# O cron roda dentro do processo web do Node. Mantenha habilitado apenas em uma
# instancia sempre ligada para evitar execucao duplicada.
CRON_ENABLED=true
CRON_TIMEZONE=America/Toronto
CRON_SEED_ALL_SCHEDULE=0 6,19 * * *
CRON_SEED_ALL_PRODUCTS_SCHEDULE=45 */6 * * *
CRON_SEED_MEYER_SCHEDULE=7 */4 * * *
CRON_SEED_ROUGH_COUNTRY_SCHEDULE=37 */4 * * *
CRON_MAGENTO_ATTRIBUTES_PRIORITY_SCHEDULE=20 2 * * *
CRON_MAGENTO_ATTRIBUTES_ROUGH_SCHEDULE=20 15 * * *

# Optional test cron job. Keep disabled by default in production.
# If enabled with seed-tdot every 5 minutes, overlap protection will prevent stacked runs.
CRON_TEST_ENABLED=false
CRON_TEST_SCHEDULE=*/5 * * * *
CRON_TEST_COMMAND=seed-tdot
CRON_TEST_JOB_NAME=TDot Cron Test
CRON_TEST_LOG_FILE=prisma/seeds/logs/seed-tdot.log
CRON_CANCELLATION_REPORT_ENABLED=true
CRON_CANCELLATION_REPORT_SCHEDULE=59 23 * * *
CRON_CANCELLATION_REPORT_TIMEZONE=America/Toronto
CRON_NOTIFICATION_EMAIL=your-email@example.com
ORDER_CANCELLATION_REPORT_EMAILS=your-email@example.com
CRON_SKU_STATUS_REPORT_ENABLED=true
CRON_SKU_STATUS_REPORT_SCHEDULE=0 22 * * *
CRON_SKU_STATUS_REPORT_TIMEZONE=America/Toronto
SKU_STATUS_REPORT_EMAILS=your-email@example.com

# SMTP credentials used by cron email notifications
EMAIL_USER=your-smtp-user@example.com
EMAIL_PASSWORD=your_smtp_password_or_api_key

# Optional Brevo SMTP relay configuration.
# Use the Brevo SMTP key, not your Brevo account login password.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASSWORD=your_brevo_smtp_key
# EMAIL_FROM="JustJeeps API <tsantos@justjeeps.com>"

# Optional Brevo HTTP API configuration. Prefer this over SMTP when your
# infrastructure allows HTTPS but blocks outbound SMTP.
# EMAIL_PROVIDER=brevo-api
# BREVO_API_KEY=xkeysib-your_real_brevo_api_key
# BREVO_FROM="JustJeeps API <tsantos@justjeeps.com>"

# -----------------------------------------------------------------------------
# Magento API
# -----------------------------------------------------------------------------
MAGENTO_KEY=sua_chave_magento_aqui

# -----------------------------------------------------------------------------
# APIs de Vendors (opcional)
# -----------------------------------------------------------------------------
# TURN14_API_KEY=
# PREMIER_API_KEY=

# =============================================================================
# JustJeeps API - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Currency conversion
# Used by seeding/services that convert vendor USD costs to CAD
USD_TO_CAD_RATE=1.55

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to enable JWT authentication
ENABLE_AUTH=false

# JWT Secret - Use a strong, randomly generated string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here

# JWT token expiration time
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# External API Keys
# -----------------------------------------------------------------------------
# Magento API Key
MAGENTO_KEY=your_magento_api_key_here

# -----------------------------------------------------------------------------
# Optional: Additional Vendor API Keys (if needed)
# -----------------------------------------------------------------------------
# TURN14_API_KEY=
# PREMIER_API_KEY=
# METALCLOAK_API_KEY=

# -----------------------------------------------------------------------------
# Email Configuration (for cron job notifications)
# -----------------------------------------------------------------------------
# Cron scheduler settings
# Set to false to disable in environments where the web process should not run jobs
CRON_ENABLED=true
CRON_TIMEZONE=America/Toronto
CRON_SEED_ALL_ENABLED=true
CRON_SEED_ALL_SCHEDULE=0 6,19 * * *
CRON_SEED_ALL_PRODUCTS_ENABLED=true
CRON_SEED_ALL_PRODUCTS_SCHEDULE=45 */6 * * *
CRON_SEED_MEYER_ENABLED=true
CRON_SEED_MEYER_SCHEDULE=7 */4 * * *
CRON_SEED_ROUGH_COUNTRY_ENABLED=true
CRON_SEED_ROUGH_COUNTRY_SCHEDULE=37 */4 * * *
CRON_MAGENTO_ATTRIBUTES_PRIORITY_ENABLED=true
CRON_MAGENTO_ATTRIBUTES_PRIORITY_SCHEDULE=20 2 * * *
CRON_MAGENTO_ATTRIBUTES_ROUGH_ENABLED=true
CRON_MAGENTO_ATTRIBUTES_ROUGH_SCHEDULE=20 15 * * *

# Optional test cron job for validating scheduler + email notifications
# Warning: seed-tdot often runs longer than 5 minutes, so overlap protection will skip
# new runs until the previous one finishes.
CRON_TEST_ENABLED=false
CRON_TEST_SCHEDULE=*/5 * * * *
CRON_TEST_COMMAND=seed-tdot
CRON_TEST_JOB_NAME=TDot Cron Test
CRON_TEST_LOG_FILE=prisma/seeds/logs/seed-tdot.log

# Optional SMTP credentials for cron notifications.
# Pair EMAIL_USER / EMAIL_PASSWORD with SMTP_SERVICE or SMTP_HOST settings below.
EMAIL_USER=your-smtp-user@example.com
EMAIL_PASSWORD=your_smtp_password_or_api_key

# Optional Brevo SMTP relay configuration.
# Use the Brevo SMTP key, not your Brevo account login password.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASSWORD=your_brevo_smtp_key
# EMAIL_FROM="JustJeeps API <tsantos@justjeeps.com>"

# Optional Brevo HTTP API configuration. Prefer this over SMTP when your
# host blocks outbound SMTP but allows HTTPS on port 443.
# EMAIL_PROVIDER=brevo-api
# BREVO_API_KEY=xkeysib-your_real_brevo_api_key
# BREVO_FROM="JustJeeps API <tsantos@justjeeps.com>"


# Email recipient for cron job notifications
CRON_NOTIFICATION_EMAIL=tsantos@justjeeps.com

# Daily SKU status change report from Items.jsx / OrderTable.jsx disable-enable buttons
CRON_SKU_STATUS_REPORT_ENABLED=true
CRON_SKU_STATUS_REPORT_SCHEDULE=0 22 * * *
CRON_SKU_STATUS_REPORT_TIMEZONE=America/Toronto
SKU_STATUS_REPORT_EMAILS=tsantos@justjeeps.com

# Weekly SKU status change report for management review
CRON_SKU_STATUS_WEEKLY_REPORT_ENABLED=true
CRON_SKU_STATUS_WEEKLY_REPORT_SCHEDULE=0 18 * * 5
CRON_SKU_STATUS_WEEKLY_REPORT_TIMEZONE=America/Toronto
SKU_STATUS_WEEKLY_REPORT_EMAILS=tsantos@justjeeps.com

# Email recipients for purchaser report (comma or space separated)
PURCHASER_REPORT_EMAILS=tsantos@justjeeps.com

# =============================================================================
# AXIOM (observability: logs and monitors)
# =============================================================================
# INGESTION token: the app ships logs/events with it. Present in the local
# .env, in .env.production and in .kamal/secrets. It can only write events.
AXIOM_TOKEN=
AXIOM_DATASET=justjeeps-api

# MANAGEMENT token (Monitors+Notifiers read/write): used ONLY by
# scripts/axiom-monitors.js when run locally. Do NOT put it in production;
# least privilege: the server only needs to ingest logs.
AXIOM_MGMT_TOKEN=
# Only if the MGMT token is a personal PAT (org tokens do not need it):
# AXIOM_ORG_ID=

# =============================================================================
# VENDOR FEEDS in DO Spaces (immutable landing zone + FeedArtifact catalog)
# See docs/FEEDS.md. Without these envs feed-sync only warns and the seeds use
# the existing local files (nothing breaks).
# =============================================================================
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=tor1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Dedicated bucket/prefix (optional; default: DO_SPACES_BUCKET + "feeds/")
# DO_SPACES_FEEDS_BUCKET=
# DO_SPACES_FEEDS_PREFIX=feeds
# Path-style only for local testing with MinIO
# DO_SPACES_FORCE_PATH_STYLE=false

# Local cache of the materialized feeds (a volume in deploy; locally: ./feed-cache)
# FEED_CACHE_DIR=
# FEED_CACHE_KEEP_BATCHES=2

# -----------------------------------------------------------------------------
# RUN LOG ARCHIVE (same Spaces credentials above)
# Every cron and every seed-all step also uploads its output to the bucket, one
# object per run. Read it back with: npm run log-archive -- list
# Without the DO_SPACES_* values above this simply does nothing.
# -----------------------------------------------------------------------------
# LOG_ARCHIVE_ENABLED=true
# DO_SPACES_LOGS_PREFIX=logs
# Cap per run; above it the TAIL is kept (that is where the failure is)
# LOG_ARCHIVE_MAX_BYTES=20971520

# Who can upload a feed and use the panel "Run now" button
FEEDS_TRIAGE_USERS=ricardo,rafael

# Keystone fetch (FTP -> Spaces): uses KEYSTONE_FTP_USER/PASS above
CRON_FEED_FETCH_KEYSTONE_ENABLED=false
# CRON_FEED_FETCH_KEYSTONE_SCHEDULE=47 4,16 * * *
# KEYSTONE_FTP_MAX_ATTEMPTS=10
# FTPS intermediate CA (the server only sends the leaf). Order: env holding the
# PEM, an absolute path outside the project, or an object in the private
# directory of the bucket.
# KEYSTONE_FTP_CA_PEM=
# KEYSTONE_FTP_CA_FILE=
# KEYSTONE_FTP_CA_OBJECT_KEY=certs/keystone-ftp-ca.pem
# KEYSTONE_FTP_MIN_SIZE_RATIO=0.9

# Freshness threshold per feed (hours): FEED_STALE_HOURS_<NAME>
# FEED_STALE_HOURS_KEYSTONE_FTP=36
# Upload cap via panel/API (bytes; above that, CLI/FTP only)
# FEED_UPLOAD_PANEL_MAX_BYTES=104857600

# =============================================================================
# USER ALLOWLISTS (who can do what). Without these envs the code uses the
# defaults; production sets them in config/deploy.yml. Comma-separated list.
# =============================================================================
# MAGENTO_STATUS_ALLOWED_USERS=
# ORDER_CANCEL_EXECUTE_ALLOWED_USERS=
# ORDER_CANCEL_DRY_RUN_ALLOWED_USERS=
# ORDER_CANCEL_MANUAL_REFUND_RESTRICTED_USERS=
# ORDER_PO_INIT_ALLOWED_USERS=
# PURCHASER_REPORT_ALLOWED_USERS=
# ORDER_CANCELLATION_REPORT_ALLOWED_USERS=
# FEEDS_TRIAGE_USERS=ricardo,rafael

# Origins accepted by the API (CORS). Production: only the panel domain.
# CORS_ALLOWED_ORIGINS=https://pricingtool.justjeeps.com
# Request limits
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=600
# Direct upload to the bucket
# FEED_MULTIPART_PART_SIZE_BYTES=8388608
# FEED_SIGNED_URL_TTL_SECONDS=900
# FEED_UPLOAD_SESSION_TTL_MS=3600000
# FEED_DOWNLOAD_PROGRESS_STEP_BYTES=10485760

# =============================================================================
# REQUESTS (internal tickets) -- docs/REQUESTS.md
# =============================================================================
# Rollout gate: while the team tests, only these users see and use the
# requests feature. Release = widen the list.
REQUESTS_ALLOWED_USERS=ricardo,admin,tess
# Triage users (can close requests and configure Trello in /settings).
REQUESTS_TRIAGE_USERS=ricardo,admin,tess
# Assignment e-mail (default on; "false" turns it off).
REQUESTS_ASSIGNMENT_EMAIL_ENABLED=true
# Daily e-mail digest (opt-in) + recipients (comma-separated).
CRON_REQUESTS_DIGEST_ENABLED=false
REQUESTS_DIGEST_EMAILS=

# Request attachments use the same DO Spaces credentials above (private
# bucket). Without them uploads answer 409 ATTACHMENTS_DISABLED.
# DO_SPACES_REQUEST_ATTACHMENTS_PREFIX=request-attachments

# Trello: NO envs -- configured 100% in the database via the /settings panel
# (global credential + board per user). See docs/REQUESTS.md.

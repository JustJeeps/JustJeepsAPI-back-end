#!/usr/bin/env bash
# Aborts the deploy BEFORE the build if any secret referenced in deploy.yml
# resolves empty/missing in the current shell. The incident class this kills:
# a deploy without `source`/dotenv of .env.production ships a container with an
# empty env (Jul 2026: 3 failed deploys from USD_TO_CAD_RATE/EMAIL_*; later an
# empty SMTP_HOST took down every alert e-mail with ECONNREFUSED 127.0.0.1:587).
#
# Rules:
# - Secrets with a LITERAL value in .kamal/secrets: ignored (they do not depend
#   on the shell).
# - Secrets with a $VAR reference: the VAR must exist and be non-empty in the
#   shell, unless it is in the OPTIONAL list below (warning only).
set -euo pipefail

cd "$(dirname "$0")/../.."

# Legitimately empty today: SendGrid is not used; SMTP_SERVICE is an alternative
# to SMTP_HOST; the report e-mail lists have a fallback in the code.
OPTIONAL="SENDGRID_API_KEY SMTP_SERVICE SKU_STATUS_REPORT_EMAILS SKU_STATUS_WEEKLY_REPORT_EMAILS ORDER_CANCELLATION_REPORT_EMAILS"

missing=()
warns=()

# Keys declared under env.secret in deploy.yml
secret_keys=$(awk '/^  secret:/{f=1;next} f&&/^    - /{print $2} f&&!/^    /{f=0}' config/deploy.yml)

for key in $secret_keys; do
  # How does .kamal/secrets resolve this key?
  line=$(grep -E "^${key}=" .kamal/secrets | head -1 || true)
  if [ -z "$line" ]; then
    missing+=("$key (no entry in .kamal/secrets)")
    continue
  fi
  value="${line#*=}"
  case "$value" in
    \$*)
      var="${value#\$}"
      if [ -z "${!var:-}" ]; then
        if [[ " $OPTIONAL " == *" $key "* ]]; then
          warns+=("$key")
        else
          missing+=("$key (\$$var empty/missing in the shell)")
        fi
      fi
      ;;
    *) : ;; # literal in the file, does not depend on the shell
  esac
done

if [ ${#warns[@]} -gt 0 ]; then
  echo "pre-build: warning, optional secrets are empty: ${warns[*]}" >&2
fi

if [ ${#missing[@]} -gt 0 ]; then
  echo "" >&2
  echo "❌ pre-build ABORTED: required secrets do not resolve in the current shell:" >&2
  printf '   - %s\n' "${missing[@]}" >&2
  echo "" >&2
  echo "   Run the deploy through the dotenv wrapper (see docs/DEPLOY + team notes):" >&2
  echo "   node -e \"require('dotenv').config({path:'.env.production'}); const {spawn}=require('child_process'); spawn('kamal',['deploy'],{stdio:'inherit',env:process.env}).on('exit',c=>process.exit(c))\"" >&2
  exit 1
fi

echo "pre-build: all $(echo "$secret_keys" | wc -w | tr -d ' ') deploy.yml secrets resolve ✔"
